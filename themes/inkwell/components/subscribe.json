{
  "id": "inkwell-subscribe",
  "name": "Inkwell · Subscribe box",
  "root": {
    "id": "subscribe",
    "kind": {
      "type": "frame",
      "element": "section"
    },
    "styles": {
      "base": {
        "base": {
          "size": {
            "width": {
              "percent": 100.0
            },
            "maxWidth": {
              "token": "space.wide"
            }
          },
          "spacing": {
            "margin": {
              "top": {
                "px": 0.0
              },
              "right": {
                "raw": "auto"
              },
              "bottom": {
                "px": 0.0
              },
              "left": {
                "raw": "auto"
              }
            },
            "padding": {
              "top": {
                "token": "space.section"
              },
              "right": {
                "token": "space.gutter"
              },
              "bottom": {
                "px": 0.0
              },
              "left": {
                "token": "space.gutter"
              }
            }
          }
        }
      }
    },
    "children": [
      {
        "id": "subscribe-box",
        "kind": {
          "type": "frame",
          "element": "div"
        },
        "styles": {
          "base": {
            "base": {
              "background": {
                "token": "surface.raised"
              },
              "spacing": {
                "padding": {
                  "top": {
                    "token": "space.10"
                  },
                  "right": {
                    "token": "space.8"
                  },
                  "bottom": {
                    "token": "space.10"
                  },
                  "left": {
                    "token": "space.8"
                  }
                }
              },
              "radius": {
                "token": "radius.md"
              },
              "display": "flex",
              "flex": {
                "direction": "column",
                "gap": {
                  "token": "space.4"
                }
              },
              "border": {
                "width": {
                  "px": 1.0
                },
                "style": "solid",
                "color": {
                  "token": "line.hairline"
                }
              }
            }
          },
          "md": {
            "base": {
              "spacing": {
                "padding": {
                  "top": {
                    "token": "space.12"
                  },
                  "right": {
                    "token": "space.12"
                  },
                  "bottom": {
                    "token": "space.12"
                  },
                  "left": {
                    "token": "space.12"
                  }
                }
              }
            }
          }
        },
        "children": [
          {
            "id": "subscribe-kicker",
            "kind": {
              "type": "text",
              "tag": "span",
              "content": "The letter"
            },
            "styles": {
              "base": {
                "base": {
                  "typography": {
                    "token": "type.label",
                    "color": {
                      "token": "ink.accent"
                    },
                    "transform": "uppercase"
                  }
                }
              }
            }
          },
          {
            "id": "subscribe-title",
            "kind": {
              "type": "text",
              "tag": "h2",
              "content": "Get the next essay in your inbox"
            },
            "styles": {
              "base": {
                "base": {
                  "typography": {
                    "token": "type.title",
                    "color": {
                      "token": "ink.body"
                    }
                  },
                  "spacing": {
                    "margin": {
                      "top": {
                        "px": 0.0
                      },
                      "right": {
                        "px": 0.0
                      },
                      "bottom": {
                        "px": 0.0
                      },
                      "left": {
                        "px": 0.0
                      }
                    }
                  },
                  "custom": {
                    "text-wrap": "balance"
                  }
                }
              }
            }
          },
          {
            "id": "subscribe-text",
            "kind": {
              "type": "text",
              "tag": "p",
              "content": "One essay every other Sunday, and nothing else. No tracking pixels, no sales. Leave whenever you like."
            },
            "styles": {
              "base": {
                "base": {
                  "typography": {
                    "token": "type.body",
                    "color": {
                      "token": "ink.muted"
                    }
                  },
                  "spacing": {
                    "margin": {
                      "top": {
                        "px": 0.0
                      },
                      "right": {
                        "px": 0.0
                      },
                      "bottom": {
                        "px": 0.0
                      },
                      "left": {
                        "px": 0.0
                      }
                    }
                  },
                  "size": {
                    "maxWidth": {
                      "rem": 34.0
                    }
                  }
                }
              }
            }
          },
          {
            "id": "subscribe-actions",
            "kind": {
              "type": "frame",
              "element": "div"
            },
            "styles": {
              "base": {
                "base": {
                  "display": "flex",
                  "flex": {
                    "direction": "row",
                    "gap": {
                      "token": "space.5"
                    },
                    "align": "center",
                    "wrap": true
                  }
                }
              }
            },
            "children": [
              {
                "id": "subscribe-button",
                "kind": {
                  "type": "button",
                  "label": "Subscribe for free",
                  "href": "/members/register",
                  "target": "same"
                },
                "styles": {
                  "base": {
                    "base": {
                      "typography": {
                        "token": "type.button",
                        "color": {
                          "token": "ink.inverse"
                        },
                        "decoration": "none"
                      },
                      "background": {
                        "token": "surface.accent"
                      },
                      "spacing": {
                        "padding": {
                          "top": {
                            "rem": 0.85
                          },
                          "right": {
                            "rem": 1.35
                          },
                          "bottom": {
                            "rem": 0.85
                          },
                          "left": {
                            "rem": 1.35
                          }
                        }
                      },
                      "radius": {
                        "token": "radius.full"
                      },
                      "transition": {
                        "duration": 160,
                        "properties": [
                          "backgroundColor",
                          "transform"
                        ],
                        "easing": "easeOut"
                      }
                    },
                    "hover": {
                      "background": {
                        "raw": "#741F1A"
                      },
                      "custom": {
                        "transform": "translateY(-1px)"
                      }
                    },
                    "focus": {
                      "custom": {
                        "outline": "2px solid #8E2B25",
                        "outline-offset": "3px"
                      }
                    }
                  }
                }
              },
              {
                "id": "subscribe-count",
                "kind": {
                  "type": "text",
                  "tag": "p",
                  "content": "Read by 4,200 people who like long sentences."
                },
                "styles": {
                  "base": {
                    "base": {
                      "typography": {
                        "token": "type.small",
                        "color": {
                          "token": "ink.muted"
                        }
                      },
                      "spacing": {
                        "margin": {
                          "top": {
                            "px": 0.0
                          },
                          "right": {
                            "px": 0.0
                          },
                          "bottom": {
                            "px": 0.0
                          },
                          "left": {
                            "px": 0.0
                          }
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    ]
