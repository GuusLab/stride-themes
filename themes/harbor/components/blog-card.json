{
  "id": "harbor-blog-card",
  "name": "Harbor · Journal card",
  "root": {
    "id": "blog-card",
    "kind": {
      "type": "link",
      "href": "/journal/october-catch",
      "target": "same"
    },
    "children": [
      {
        "id": "blog-card-card",
        "kind": {
          "type": "frame"
        },
        "children": [
          {
            "id": "blog-card-media",
            "kind": {
              "type": "frame"
            },
            "children": [
              {
                "id": "blog-card-img",
                "kind": {
                  "type": "image",
                  "src": "assets/images/table.webp",
                  "alt": ""
                },
                "styles": {
                  "base": {
                    "base": {
                      "display": "block",
                      "size": {
                        "width": {
                          "percent": 100.0
                        }
                      },
                      "objectFit": "cover",
                      "aspectRatio": {
                        "ratio": {
                          "width": 3.0,
                          "height": 2.0
                        }
                      }
                    }
                  }
                },
                "bindings": {
                  "src": "image"
                }
              }
            ],
            "styles": {
              "base": {
                "base": {
                  "overflow": "hidden"
                }
              }
            }
          },
          {
            "id": "blog-card-body",
            "kind": {
              "type": "frame"
            },
            "children": [
              {
                "id": "blog-card-meta",
                "kind": {
                  "type": "frame"
                },
                "children": [
                  {
                    "id": "blog-card-tag",
                    "kind": {
                      "type": "text",
                      "tag": "span",
                      "content": "Seasonal"
                    },
                    "styles": {
                      "base": {
                        "base": {
                          "typography": {
                            "token": "type.eyebrow",
                            "color": {
                              "token": "ink.accent"
                            },
                            "transform": "uppercase"
                          }
                        }
                      }
                    },
                    "bindings": {
                      "content": "tag"
                    }
                  },
                  {
                    "id": "blog-card-date",
                    "kind": {
                      "type": "text",
                      "tag": "span",
                      "content": "Oct 2, 2026"
                    },
                    "styles": {
                      "base": {
                        "base": {
                          "typography": {
                            "token": "type.small",
                            "color": {
                              "token": "ink.muted"
                            }
                          }
                        }
                      }
                    },
                    "bindings": {
                      "content": "date"
                    }
                  }
                ],
                "styles": {
                  "base": {
                    "base": {
                      "display": "flex",
                      "flex": {
                        "direction": "row",
                        "gap": {
                          "px": 12.0
                        },
                        "align": "center",
                        "wrap": true,
                        "justify": "spaceBetween"
                      }
                    }
                  }
                }
              },
              {
                "id": "blog-card-title",
                "kind": {
                  "type": "text",
                  "tag": "h3",
                  "content": "What the boats brought in this October"
                },
                "styles": {
                  "base": {
                    "base": {
                      "typography": {
                        "token": "type.subtitle",
                        "color": {
                          "token": "ink.body"
                        }
                      }
                    }
                  }
                },
                "bindings": {
                  "content": "title"
                }
              },
              {
                "id": "blog-card-dek",
                "kind": {
                  "type": "text",
                  "tag": "p",
                  "content": "Hake, mackerel and the first mussels of the cold months, and what we are doing with them."
                },
                "styles": {
                  "base": {
                    "base": {
                      "typography": {
                        "token": "type.small",
                        "color": {
                          "token": "ink.muted"
                        }
                      }
                    }
                  }
                },
                "bindings": {
                  "content": "excerpt"
                }
              }
            ],
            "styles": {
              "base": {
                "base": {
                  "display": "flex",
                  "flex": {
                    "direction": "column",
                    "gap": {
                      "px": 10.0
                    }
                  },
                  "spacing": {
                    "padding": {
                      "top": {
                        "px": 22.0
                      },
                      "right": {
                        "px": 24.0
                      },
                      "bottom": {
                        "px": 28.0
                      },
                      "left": {
                        "px": 24.0
                      }
                    }
                  }
                }
              }
            }
          }
        ],
        "styles": {
          "base": {
            "base": {
              "background": {
                "token": "surface.card"
              },
              "radius": {
                "token": "radius.lg"
              },
              "border": {
                "width": {
                  "px": 1.0
                },
                "style": "solid",
                "color": {
                  "token": "line.hairline"
                }
              },
              "shadow": {
                "token": "shadow.soft"
              },
              "overflow": "hidden",
              "display": "flex",
              "flex": {
                "direction": "column"
              },
              "size": {
                "height": {
                  "percent": 100.0
                }
              },
              "transition": {
                "duration": 250,
                "easing": "easeOut",
                "properties": [
                  "transform",
                  "boxShadow"
                ]
              }
            },
            "hover": {
              "shadow": {
                "token": "shadow.card"
              },
              "custom": {
                "transform": "translateY(-4px)"
              }
            }
          }
        }
      }
    ],
    "styles": {
      "base": {
        "base": {
          "typography": {
            "decoration": "none"
          },
          "display": "block"
        }
      }
    },
    "bindings": {
      "href": "href"
    }
  },
  "props": [
    {
      "name": "image",
      "label": "Photo",
      "kind": {
        "type": "image"
      },
      "default": "assets/images/table.webp"
    },
    {
      "name": "tag",
      "label": "Category",
      "kind": {
        "type": "text"
      },
      "default": "Seasonal"
    },
    {
      "name": "date",
      "label": "Date",
      "kind": {
        "type": "text"
      },
      "default": "Oct 2, 2026"
    },
    {
      "name": "title",
      "label": "Title",
      "kind": {
        "type": "text"
      },
      "default": "What the boats brought in this October"
    },
    {
      "name": "excerpt",
      "label": "Excerpt",
      "kind": {
        "type": "longText"
      },
      "default": "Hake, mackerel and the first mussels of the cold months, and what we are doing with them."
    },
    {
      "name": "href",
      "label": "Link",
      "kind": {
        "type": "url"
      },
      "default": "/journal/october-catch"
    }
  ]
}