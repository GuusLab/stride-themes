{
  "id": "grove-testimonial",
  "name": "Grove / Testimonial",
  "root": {
    "id": "testimonial",
    "kind": {
      "type": "frame",
      "element": "section"
    },
    "styles": {
      "base": {
        "base": {
          "background": {
            "token": "surface.deep"
          },
          "spacing": {
            "padding": {
              "top": {
                "token": "section.y"
              },
              "right": {
                "token": "gutter"
              },
              "bottom": {
                "token": "section.y"
              },
              "left": {
                "token": "gutter"
              }
            }
          },
          "position": {
            "kind": "relative"
          },
          "overflow": "hidden"
        }
      }
    },
    "children": [
      {
        "id": "tq-blob",
        "kind": {
          "type": "frame",
          "element": "div"
        },
        "styles": {
          "base": {
            "base": {
              "position": {
                "kind": "absolute",
                "inset": {
                  "top": {
                    "px": -200.0
                  },
                  "left": {
                    "px": -240.0
                  }
                },
                "zIndex": 0
              },
              "size": {
                "width": {
                  "px": 560.0
                },
                "height": {
                  "px": 560.0
                }
              },
              "background": {
                "raw": "#3B5243"
              },
              "radius": {
                "token": "radius.organic"
              },
              "opacity": 1,
              "custom": {
                "pointer-events": "none",
                "filter": "blur(2px)"
              }
            }
          }
        }
      },
      {
        "id": "tq-inner",
        "kind": {
          "type": "frame",
          "element": "div"
        },
        "styles": {
          "base": {
            "base": {
              "display": "flex",
              "flex": {
                "direction": "column",
                "gap": {
                  "px": 0.0
                }
              },
              "size": {
                "maxWidth": {
                  "token": "content.max"
                },
                "width": {
                  "percent": 100.0
                }
              },
              "spacing": {
                "margin": {
                  "left": {
                    "raw": "auto"
                  },
                  "right": {
                    "raw": "auto"
                  }
                }
              },
              "position": {
                "kind": "relative"
              }
            }
          }
        },
        "children": [
          {
            "id": "tq-grid",
            "kind": {
              "type": "frame",
              "element": "div"
            },
            "styles": {
              "base": {
                "base": {
                  "display": "grid",
                  "grid": {
                    "columns": 1,
                    "gap": {
                      "px": 56.0
                    },
                    "align": "center"
                  }
                }
              },
              "lg": {
                "base": {
                  "display": "grid",
                  "grid": {
                    "templateColumns": "1.3fr 0.9fr",
                    "gap": {
                      "px": 80.0
                    },
                    "align": "center"
                  }
                }
              }
            },
            "children": [
              {
                "id": "tq",
                "kind": {
                  "type": "frame",
                  "element": "div"
                },
                "styles": {
                  "base": {
                    "base": {
                      "display": "flex",
                      "flex": {
                        "direction": "column",
                        "gap": {
                          "px": 28.0
                        }
                      },
                      "size": {
                        "maxWidth": {
                          "px": 820.0
