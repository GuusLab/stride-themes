              "bottom": {
                "token": "space.section"
              },
              "left": {
                "token": "space.gutter"
              },
              "right": {
                "token": "space.gutter"
              }
            }
          }
        }
      },
      "md": {
        "base": {
          "spacing": {
            "padding": {
