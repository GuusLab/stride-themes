                        }
                      }
                    }
                  },
                  {
                    "id": "gallery-3",
                    "kind": {
                      "type": "image",
                      "src": "assets/images/team.webp",
                      "alt": "Three teammates reviewing results on a laptop"
                    },
                    "styles": {
                      "base": {
                        "base": {
                          "size": {
                            "width": {
                              "percent": 100
                            }
                          },
                          "radius": {
                            "token": "radius.lg"
                          },
                          "objectFit": "cover",
                          "aspectRatio": {
                            "ratio": {
                              "width": 16,
                              "height": 9
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              }
            ]
          }
