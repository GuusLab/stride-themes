                        "base": {
                          "typography": {
                            "token": "type.label",
                            "color": {
                              "token": "ink.accent"
                            },
                            "transform": "uppercase"
                          }
                        }
                      }
                    },
                    "bindings": {
                      "content": "eyebrow"
