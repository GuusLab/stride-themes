  "props": [
    {
      "name": "eyebrow",
      "label": "Eyebrow",
      "kind": {
        "type": "text"
      },
      "default": "Inside Vantora"
    },
    {
      "name": "title",
      "label": "Heading",
      "kind": {
        "type": "text"
      },
      "default": "Built in the open, with our customers in the room."
    }
