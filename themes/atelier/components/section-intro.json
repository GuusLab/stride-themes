{
  "id": "atelier-section-intro",
  "name": "Atelier · Section intro",
  "root": {
    "id": "si",
    "kind": {
      "type": "frame",
      "element": "div"
    },
    "styles": {
      "base": {
        "base": {
          "display": "grid",
          "grid": {
            "templateColumns": "minmax(0,1fr)",
            "gap": {
              "token": "space.6"
            }
          },
          "border": {
            "top": {
              "width": {
                "px": 1
              },
              "style": "solid",
              "color": {
                "token": "line.strong"
              }
            }
          },
          "spacing": {
            "padding": {
              "top": {
                "token": "space.6"
              }
            }
          }
        }
      },
      "md": {
        "base": {
          "grid": {
            "templateColumns": "minmax(0, 4fr) minmax(0, 8fr)",
            "gap": {
              "token": "space.8"
            }
          }
        }
      }
    },
    "children": [
      {
        "id": "si-n",
        "kind": {
          "type": "text",
          "tag": "p",
          "content": "(01) — Services"
        },
        "styles": {
          "base": {
            "base": {
              "typography": {
                "token": "type.label",
                "color": {
                  "token": "ink.accent"
                },
                "transform": "uppercase"
              }
            }
          }
        },
        "bindings": {
          "content": "eyebrow"
        }
      },
      {
        "id": "si-t",
        "kind": {
          "type": "frame",
          "element": "div"
        },
        "styles": {
          "base": {
            "base": {
              "display": "flex",
              "flex": {
                "direction": "column",
                "gap": {
                  "token": "space.4"
                }
              }
            }
          }
        },
        "children": [
          {
            "id": "si-h",
            "kind": {
              "type": "text",
              "tag": "h2",
              "content": "What we do, and what we will not."
            },
            "styles": {
              "base": {
                "base": {
                  "typography": {
                    "token": "type.title",
                    "color": {
                      "token": "ink.body"
                    }
                  },
                  "custom": {
                    "text-wrap": "balance"
                  },
                  "size": {
                    "maxWidth": {
                      "raw": "18ch"
                    }
                  }
                }
              }
            },
            "bindings": {
              "content": "title"
            }
          },
          {
            "id": "si-p",
            "kind": {
              "type": "text",
              "tag": "p",
              "content": "Every engagement starts with a question, not a deliverable."
            },
            "styles": {
              "base": {
                "base": {
                  "typography": {
                    "token": "type.lead",
                    "color": {
                      "token": "ink.muted"
                    }
                  },
                  "size": {
                    "maxWidth": {
                      "raw": "46ch"
                    }
                  }
                }
              }
            },
            "bindings": {
              "content": "lead"
            }
          }
        ]
      }
    ]
  },
  "props": [
    {
      "name": "eyebrow",
      "label": "Number & label",
      "kind": {
        "type": "text"
      },
      "default": "(01) — Services"
    },
    {
      "name": "title",
      "label": "Title",
      "kind": {
        "type": "longText"
      },
      "default": "What we do, and what we will not."
    },
    {
      "name": "lead",
      "label": "Lead",
      "kind": {
        "type": "longText"
      },
      "default": "Every engagement starts with a question, not a deliverable."
    }
  ]
}
