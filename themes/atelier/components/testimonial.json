{
  "id": "atelier-testimonial",
  "name": "Atelier · Testimonial",
  "root": {
    "id": "tm",
    "kind": {
      "type": "frame",
      "element": "section"
    },
    "styles": {
      "base": {
        "base": {
          "background": {
            "token": "surface.accent"
          },
          "spacing": {
            "padding": {
              "top": {
                "token": "space.section"
              },
              "bottom": {
                "token": "space.section"
              },
              "left": {
                "token": "space.gutter"
              },
              "right": {
                "token": "space.gutter"
              }
            }
          }
        }
      }
    },
    "children": [
      {
        "id": "tm-in",
        "kind": {
          "type": "frame",
          "element": "div"
        },
        "styles": {
          "base": {
            "base": {
              "size": {
                "maxWidth": {
                  "px": 1320
                },
                "width": {
                  "percent": 100
                }
              },
              "spacing": {
                "margin": {
                  "left": {
                    "raw": "auto"
                  },
                  "right": {
                    "raw": "auto"
                  }
                }
              },
              "display": "grid",
              "grid": {
                "templateColumns": "minmax(0,1fr)",
                "gap": {
                  "token": "space.8"
                }
              }
            }
          },
          "md": {
            "base": {
              "grid": {
                "templateColumns": "minmax(0, 3fr) minmax(0, 9fr)",
                "gap": {
                  "token": "space.8"
                }
              }
            }
          }
        },
        "children": [
          {
            "id": "tm-mark",
            "kind": {
              "type": "text",
              "tag": "p",
              "content": "“"
            },
            "styles": {
              "base": {
                "base": {
                  "typography": {
                    "token": "type.hero",
                    "color": {
                      "token": "ink.on-accent"
                    },
                    "lineHeight": 0.7,
                    "size": {
                      "raw": "clamp(6rem, 14vw, 12rem)"
                    }
                  },
                  "custom": {
                    "user-select": "none"
                  }
                }
              }
            }
          },
          {
            "id": "tm-body",
            "kind": {
              "type": "frame",
              "element": "div"
            },
            "styles": {
              "base": {
                "base": {
                  "display": "flex",
                  "flex": {
                    "direction": "column",
                    "gap": {
                      "token": "space.8"
                    }
                  }
                }
              }
            },
            "children": [
              {
                "id": "tm-q",
                "kind": {
                  "type": "text",
                  "tag": "blockquote",
                  "content": "They listened for three weeks before they showed us a single sketch. The identity they made has outlived two rebrands we almost commissioned."
                },
                "styles": {
                  "base": {
                    "base": {
                      "typography": {
                        "token": "type.quote",
                        "color": {
                          "token": "ink.on-accent"
                        }
                      },
                      "custom": {
                        "font-style": "italic",
                        "text-wrap": "pretty"
                      }
                    }
                  }
                },
                "bindings": {
                  "content": "quote"
                }
              },
              {
                "id": "tm-who",
                "kind": {
                  "type": "frame",
                  "element": "div"
                },
                "styles": {
                  "base": {
                    "base": {
                      "display": "flex",
                      "flex": {
                        "direction": "row",
                        "align": "center",
                        "gap": {
                          "px": 16
                        }
                      }
                    }
                  }
                },
                "children": [
                  {
                    "id": "tm-img",
                    "kind": {
                      "type": "image",
                      "src": "assets/images/portrait.webp",
                      "alt": "Portrait of Inés Carvalho"
                    },
                    "styles": {
                      "base": {
                        "base": {
                          "size": {
                            "width": {
                              "px": 56
                            },
                            "height": {
                              "px": 56
                            }
                          },
                          "aspectRatio": {
                            "ratio": {
                              "width": 1,
                              "height": 1
                            }
                          },
                          "objectFit": "cover",
                          "display": "block",
                          "radius": {
                            "token": "radius.full"
                          }
                        }
                      }
                    },
                    "bindings": {
                      "src": "image",
                      "alt": "imageAlt"
                    }
                  },
                  {
                    "id": "tm-who-t",
                    "kind": {
                      "type": "frame",
                      "element": "div"
                    },
                    "styles": {
                      "base": {
                        "base": {
                          "display": "flex",
                          "flex": {
                            "direction": "column",
                            "gap": {
                              "token": "space.1"
                            }
                          }
                        }
                      }
                    },
                    "children": [
                      {
                        "id": "tm-n",
                        "kind": {
                          "type": "text",
                          "tag": "p",
                          "content": "Inés Carvalho"
                        },
                        "styles": {
                          "base": {
                            "base": {
                              "typography": {
                                "token": "type.nav",
                                "color": {
                                  "token": "ink.on-accent"
                                }
                              }
                            }
                          }
                        },
                        "bindings": {
                          "content": "name"
                        }
                      },
                      {
                        "id": "tm-r",
                        "kind": {
                          "type": "text",
                          "tag": "p",
                          "content": "Founder, Casa Ribeira"
                        },
                        "styles": {
                          "base": {
                            "base": {
                              "typography": {
                                "token": "type.small",
                                "color": {
                                  "token": "ink.on-accent"
                                }
                              },
                              "opacity": 0.85
                            }
                          }
                        },
                        "bindings": {
                          "content": "role"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "props": [
    {
      "name": "quote",
      "label": "Quote",
      "kind": {
        "type": "longText"
      },
      "default": "They listened for three weeks before they showed us a single sketch. The identity they made has outlived two rebrands we almost commissioned."
    },
    {
      "name": "name",
      "label": "Name",
      "kind": {
        "type": "text"
      },
      "default": "Inés Carvalho"
    },
    {
      "name": "role",
      "label": "Role",
      "kind": {
        "type": "text"
      },
      "default": "Founder, Casa Ribeira"
    },
    {
      "name": "image",
      "label": "Portrait",
      "kind": {
        "type": "image"
      },
      "default": "assets/images/portrait.webp"
    },
    {
      "name": "imageAlt",
      "label": "Portrait description",
      "kind": {
        "type": "text"
      },
      "default": "Portrait of Inés Carvalho"
    }
  ],
  "variants": {
    "accent": {},
    "ink": {
      "styles": {
        "base": {
          "base": {
            "background": {
              "token": "surface.deep"
            }
          }
        }
      }
    }
  },
  "defaultVariant": "accent"
}
