{
  "id": "atelier-header",
  "name": "Atelier · Header",
  "root": {
    "id": "hd",
    "kind": {
      "type": "frame",
      "element": "header"
    },
    "styles": {
      "base": {
        "base": {
          "background": {
            "token": "surface.page"
          },
          "spacing": {
            "padding": {
              "top": {
                "px": 22
              },
              "bottom": {
                "px": 22
              },
              "left": {
                "token": "space.gutter"
              },
              "right": {
                "token": "space.gutter"
              }
            }
          },
          "border": {
            "bottom": {
              "width": {
                "px": 1
              },
              "style": "solid",
              "color": {
                "token": "line.hairline"
              }
            }
          }
        }
      }
    },
    "children": [
      {
        "id": "hd-row",
        "kind": {
          "type": "frame",
          "element": "div"
        },
        "styles": {
          "base": {
            "base": {
              "size": {
                "maxWidth": {
                  "px": 1320
                },
                "width": {
                  "percent": 100
                }
              },
              "spacing": {
                "margin": {
                  "left": {
                    "raw": "auto"
                  },
                  "right": {
                    "raw": "auto"
                  }
                }
              },
              "display": "flex",
              "flex": {
                "direction": "row",
                "wrap": true,
                "align": "center",
                "justify": "spaceBetween",
                "gap": {
                  "px": 16
                }
              }
            }
          }
        },
        "children": [
          {
            "id": "hd-brand",
            "kind": {
              "type": "link",
              "href": "/",
              "target": "same"
            },
            "styles": {
              "base": {
                "base": {
                  "display": "inlineFlex",
                  "flex": {
                    "align": "baseline",
                    "gap": {
                      "px": 6
                    }
                  },
                  "typography": {
                    "decoration": "none"
                  }
                }
              }
            },
            "children": [
              {
                "id": "hd-brand-t",
                "kind": {
                  "type": "text",
                  "tag": "span",
                  "content": "Hollis & Vane"
                },
                "styles": {
                  "base": {
                    "base": {
                      "typography": {
                        "token": "type.subtitle",
                        "color": {
                          "token": "ink.body"
                        },
                        "size": {
                          "raw": "1.625rem"
                        },
                        "lineHeight": 1
                      }
                    }
                  }
                },
                "bindings": {
                  "content": "brand"
                }
              },
              {
                "id": "hd-brand-dot",
                "kind": {
                  "type": "text",
                  "tag": "span",
                  "content": "●"
                },
                "styles": {
                  "base": {
                    "base": {
                      "typography": {
                        "color": {
                          "token": "brand.primary"
                        },
                        "size": {
                          "px": 9
                        }
                      }
                    }
                  }
                },
                "props": {
                  "aria-hidden": "true"
                }
              }
            ]
          },
          {
            "id": "hd-nav",
            "kind": {
              "type": "frame",
              "element": "nav"
            },
            "styles": {
              "base": {
                "base": {
                  "display": "flex",
                  "flex": {
                    "direction": "row",
                    "wrap": true,
                    "align": "center",
                    "gap": {
                      "px": 20
                    }
                  }
                }
              },
              "md": {
                "base": {
                  "flex": {
                    "direction": "row",
                    "gap": {
                      "px": 36
                    },
                    "align": "center"
                  }
                }
              }
            },
            "children": [
              {
                "id": "hd-n0",
                "kind": {
                  "type": "link",
                  "href": "/work",
                  "target": "same"
                },
                "styles": {
                  "base": {
                    "base": {
                      "typography": {
                        "token": "type.nav",
                        "color": {
                          "token": "ink.body"
                        },
                        "decoration": "none"
                      },
                      "transition": {
                        "duration": 180,
                        "properties": [
                          "color"
                        ]
                      }
                    },
                    "hover": {
                      "typography": {
                        "color": {
                          "token": "ink.accent"
                        }
                      }
                    }
                  }
                },
                "bindings": {
                  "href": "nav1Href"
                },
                "children": [
                  {
                    "id": "hd-n0-t",
                    "kind": {
                      "type": "text",
