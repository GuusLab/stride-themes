                      "content": "Work"
                    },
                    "bindings": {
                      "content": "nav1Label"
                    }
                  }
                ]
              },
              {
                "id": "hd-n1",
                "kind": {
                  "type": "link",
                  "href": "/about",
                  "target": "same"
                },
                "styles": {
                  "base": {
                    "base": {
                      "typography": {
                        "token": "type.nav",
                        "color": {
                          "token": "ink.body"
                        },
                        "decoration": "none"
                      },
                      "transition": {
                        "duration": 180,
                        "properties": [
                          "color"
                        ]
                      }
                    },
                    "hover": {
                      "typography": {
                        "color": {
                          "token": "ink.accent"
                        }
                      }
                    }
                  }
                },
                "bindings": {
                  "href": "nav2Href"
                },
                "children": [
                  {
                    "id": "hd-n1-t",
                    "kind": {
                      "type": "text",
                      "tag": "span",
                      "content": "Studio"
                    },
                    "bindings": {
                      "content": "nav2Label"
                    }
                  }
                ]
              },
              {
                "id": "hd-n2",
                "kind": {
                  "type": "link",
                  "href": "/journal",
                  "target": "same"
                },
                "styles": {
                  "base": {
                    "base": {
                      "typography": {
                        "token": "type.nav",
                        "color": {
                          "token": "ink.body"
                        },
                        "decoration": "none"
                      },
                      "transition": {
                        "duration": 180,
                        "properties": [
                          "color"
                        ]
                      }
                    },
                    "hover": {
                      "typography": {
                        "color": {
                          "token": "ink.accent"
                        }
                      }
                    }
                  }
                },
                "bindings": {
                  "href": "nav3Href"
                },
                "children": [
                  {
                    "id": "hd-n2-t",
                    "kind": {
                      "type": "text",
                      "tag": "span",
                      "content": "Journal"
                    },
                    "bindings": {
                      "content": "nav3Label"
                    }
                  }
                ]
              },
              {
                "id": "hd-n3",
                "kind": {
                  "type": "link",
                  "href": "/contact",
                  "target": "same"
                },
                "styles": {
                  "base": {
                    "base": {
                      "typography": {
                        "token": "type.nav",
                        "color": {
                          "token": "ink.body"
                        },
                        "decoration": "none"
                      },
                      "transition": {
                        "duration": 180,
                        "properties": [
                          "color"
                        ]
                      }
                    },
                    "hover": {
                      "typography": {
                        "color": {
                          "token": "ink.accent"
                        }
                      }
                    }
                  }
                },
                "bindings": {
                  "href": "nav4Href"
                },
                "children": [
                  {
                    "id": "hd-n3-t",
                    "kind": {
                      "type": "text",
                      "tag": "span",
                      "content": "Contact"
                    },
                    "bindings": {
                      "content": "nav4Label"
                    }
                  }
                ]
              },
              {
                "id": "hd-cta",
                "kind": {
                  "type": "button",
                  "label": "Start a project",
                  "href": "/contact",
                  "target": "same"
                },
                "styles": {
                  "base": {
                    "base": {
                      "display": "none",
                      "typography": {
                        "token": "type.nav",
                        "color": {
                          "token": "ink.inverse"
                        },
                        "decoration": "none"
                      },
                      "background": {
                        "token": "surface.night"
                      },
                      "spacing": {
                        "padding": {
                          "top": {
                            "px": 11
                          },
                          "bottom": {
                            "px": 11
                          },
                          "left": {
                            "px": 20
                          },
                          "right": {
                            "px": 20
                          }
                        }
                      },
                      "radius": {
                        "token": "radius.full"
                      },
                      "transition": {
                        "duration": 200,
                        "properties": [
                          "backgroundColor"
                        ]
                      }
                    },
                    "hover": {
                      "background": {
                        "token": "brand.primary"
                      }
                    }
                  },
                  "md": {
                    "base": {
                      "display": "inlineFlex"
                    }
                  }
                },
                "bindings": {
                  "label": "ctaLabel",
                  "href": "ctaHref"
                }
              }
            ]
          }
        ]
      }
    ]
