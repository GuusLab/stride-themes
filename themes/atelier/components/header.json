  "props": [
    {
      "name": "brand",
      "label": "Studio name",
      "kind": {
        "type": "text"
      },
      "default": "Hollis & Vane"
    },
    {
      "name": "nav1Label",
      "label": "Link 1 label",
      "kind": {
        "type": "text"
      },
      "default": "Work"
    },
    {
      "name": "nav1Href",
      "label": "Link 1 address",
      "kind": {
        "type": "url"
      },
      "default": "/work"
    },
    {
      "name": "nav2Label",
      "label": "Link 2 label",
      "kind": {
        "type": "text"
      },
      "default": "Studio"
    },
    {
      "name": "nav2Href",
      "label": "Link 2 address",
      "kind": {
        "type": "url"
      },
      "default": "/about"
    },
    {
      "name": "nav3Label",
      "label": "Link 3 label",
      "kind": {
        "type": "text"
      },
      "default": "Journal"
    },
    {
      "name": "nav3Href",
      "label": "Link 3 address",
      "kind": {
        "type": "url"
      },
      "default": "/journal"
    },
    {
      "name": "nav4Label",
      "label": "Link 4 label",
      "kind": {
        "type": "text"
      },
      "default": "Contact"
    },
    {
      "name": "nav4Href",
      "label": "Link 4 address",
      "kind": {
        "type": "url"
      },
      "default": "/contact"
    },
    {
      "name": "ctaLabel",
      "label": "Button label",
      "kind": {
        "type": "text"
      },
      "default": "Start a project"
    },
    {
      "name": "ctaHref",
      "label": "Button link",
      "kind": {
        "type": "url"
      },
      "default": "/contact"
    }
  ]
